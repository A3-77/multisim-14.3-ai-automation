# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 探索期中间产物（只保留 out/ref/ 下的关键产物）
out/*
!out/ref/
!out/ref/**
# 验收证据（README 直接引用，必须能被点开）
!out/p0_validation.json
!out/p0_waveform_source.csv
!out/p0_waveform_divider.csv
# RC 低通三点频响的验证数据
!out/p19_rc_*.json
!out/p19_rc_*.csv
# Circuit IR 端到端验收的数据
!out/rc_ir_result.json
!out/rc_ir_waveform.csv
# 中文 → IR 端到端验收的数据（README 引用）
!out/nl/
!out/nl/*.result.json
!out/nl/*.ir.json
!out/nl/*.waveform.csv
!out/nl/*.compile.json
out/nl/*.ms14
# 直流静态电路取数的证据（docs/dc-static.md 直接引用，必须能被点开）
!out/dc/
!out/dc/*.json
!out/dc/*.csv
!out/dc/*.py
out/dc/*.ms14
# MCP 验收结果（docs/mcp.md 直接引用）；会话目录是运行产物，可重跑生成
!out/mcp/
!out/mcp/*.json
out/mcp/sessions/
out/mcp/*.log

# Agent Acceptance Test 的证据（docs/case/ 与报告直接引用）
!out/agent_test/
!out/agent_test/*.py
!out/agent_test/*.json
!out/agent_test/*.md
!out/agent_test/*.log
out/agent_test/*.png
out/agent_test/*.ms14
# 第二次验收（二阶 / 多节点）
!out/agent_test2/
!out/agent_test2/*.py
!out/agent_test2/*.json
!out/agent_test2/*.md
!out/agent_test2/*.log

# v0.8.0 LLM → MCP 验收：trace（jsonl）、Agent 报告、独立复算、波形证据
# 会话目录 out/mcp/sessions 仍是运行产物，不入库（可用 trace 里的 circuit_id 重跑）
!out/agent_v08/
!out/agent_v08/**
out/agent_v08/**/*.ms14

# 32 位运行时（体积大，可用 run.bat / setup_env.py 重建）
runtime/

# Multisim 安装目录缓存
samples/*.ewsnip

# 编辑器
.vscode/
.idea/
*.swp

# 系统
Thumbs.db
desktop.ini
probe_template.ms14 (Security copy)
out/agent_v08/**/.inject-*.done
